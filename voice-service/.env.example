# Copy to voice-service/.env and fill secrets locally. Do not commit real keys.
# Required by common-py at startup; identical to the Java/RAG JWT secret.
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8008
OPENAI_API_KEY=
# User-selected evaluation judge. Connect/read inactivity limits are user-confirmed.
EVAL_JUDGE_MODEL=gpt-6-luna
EVAL_JUDGE_CONNECT_TIMEOUT=5
EVAL_JUDGE_READ_TIMEOUT=30
WHISPER_MODEL=small
TTS_MODEL=tts-1
TTS_VOICE=nova
# Local development. Container networking may use http://rag:8001 explicitly.
RAG_URL=http://localhost:8001
