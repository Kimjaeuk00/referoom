# 로컬에서 Gradle로 실행할 때 사용하는 DB 접속 예시
DB_HOST=localhost
DB_PORT=53301
DB_NAME=sql_db
DB_USER=root

# 실제 비밀번호는 .env에만 입력
DB_PASSWORD=

# Java·RAG·음성 서비스에서 동일한 비밀키 사용
# 실제 비밀키는 .env에만 입력
JWT_SECRET=

# 브라우저에서 접근하는 프론트 주소
FRONTEND_URL=http://localhost:5174

# 쉼표로 구분한 허용 Origin
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8008
