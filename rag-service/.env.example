# 변수 이름만 적은 예시입니다. 실제 값은 이 폴더의 .env에 넣고 커밋하지 않습니다.
# 설정의 기본값과 설명은 app/rag/config_rag.py에 있습니다.

# 필수: 인증서버와 같은 값
JWT_SECRET=
# stub(테스트용 더미) | local(app/rag/local_store 색인)
RAG_STORE=local
OPENAI_API_KEY=

# Zotero 그룹 (논문 라이브러리의 원천). 값은 프로젝트 루트 .env에 두어도 된다(이 폴더 .env가 우선)
# 그룹 이름이 아닌 숫자 ID. 키에는 그룹 읽기·쓰기·파일 권한이 필요하다
ZOTERO_GROUP_ID=
ZOTERO_API_KEY=
# 이 그룹을 연결할 팀 (비우면 LOCAL_TEAM_ID)
ZOTERO_TEAM_ID=

# 선택 (기본값은 app/rag/config_rag.py)
# ZOTERO_CACHE_SECONDS=30        논문 목록을 Zotero에서 다시 받기까지의 캐시 시간(초)
# TOPIC_MIN_RELEVANCE=0.50       이 값 미만의 arXiv 후보에 '관련도 낮음' 경고
# TOPIC_CACHE_SECONDS=600        검색한 후보를 수집 요청이 다시 쓰도록 보관하는 시간(초)

# v0.2 모드의 상한 (기본값은 app/rag/config_rag.py, 측정 전의 시작값)
# PRIOR_MAX_PAPERS=10            선행연구: 한 번에 비교할 논문 수
# PRIOR_CHUNKS_PER_PAPER=4       선행연구: 논문당 근거 청크 수
# PRIOR_WORKERS=4                선행연구: 논문별 추출 병렬 스레드 수
# TOPIC_MAX_PAPERS=10            주제: 대상 논문 상한
# TOPIC_CHUNKS_PER_PAPER=3       주제: 논문당 '한계' 근거 청크 수
# TOPIC_SIMILAR_MIN_SCORE=0.60   주제: 유사 연구로 보이는 최소 유사도
# VERIFY_MAX_CLAIMS=12           검증: 한 원고에서 대조할 주장 수
# VERIFY_EVIDENCE_CHUNKS=3       검증: 주장마다 모으는 근거 청크 수
# SUMMARY_CHUNKS_PER_SECTION=3   요약: 섹션마다 모으는 청크 수

# 팀당 호출 한도(비용이 큰 모드 경로). 0이면 꺼짐, 창은 초 단위
RATE_LIMIT_CALLS=0
RATE_LIMIT_WINDOW_SECONDS=3600
