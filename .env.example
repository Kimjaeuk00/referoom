# 이 파일을 참고해 프로젝트 루트의 .env에 실제 값을 입력하세요.
# 예시 파일에는 실제 API 키를 기록하지 마세요.
# 현재 테스트 코드는 .env를 직접 읽으며, provider는 값을 인자로 받습니다.

# [현재 Zotero 테스트 필수] 그룹 이름이 아닌 숫자 ID
# 예: https://www.zotero.org/groups/1234567/referoom → 1234567
ZOTERO_GROUP_ID=

# [현재 Zotero 테스트 필수] 본인 계정에서 발급한 Zotero API 키
# 대상 그룹의 라이브러리 읽기·쓰기 및 파일 접근 권한이 필요합니다.
# PDF 저장을 위해 그룹 설정에서도 File Editing을 허용해야 합니다.
# arXiv 검색 자체에는 API 키가 필요하지 않습니다.
ZOTERO_API_KEY=

# [추후 DB 암호화 저장용] API 키와 별개인 Fernet 암호화 키
# 현재 provider 테스트에는 필요하지 않으며, 암호화 저장 연결도 아직 없습니다.
# 생성 예시 (cryptography 설치 후):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZOTERO_KEY_SECRET=
